# Copy to .env.test.local and fill in values for a local or dedicated test Supabase project.
# NEVER point these at your production project — tests create and delete real rows.
#
# Option A — local Supabase (recommended):
#   1. Install Supabase CLI: https://supabase.com/docs/guides/cli
#   2. Run: supabase init && supabase start
#   3. Copy the local URLs/keys printed by `supabase status`
#
# Option B — dedicated test project:
#   Create a separate Supabase project just for testing and paste its keys below.

TEST_SUPABASE_URL=http://localhost:54321
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
