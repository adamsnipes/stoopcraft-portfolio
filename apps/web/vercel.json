{
  "buildCommand": "cd ../.. && npx supabase db push --db-url $SUPABASE_DB_URL --yes && cd apps/web && next build",
  "crons": [
    {
      "path": "/api/cron/hard-delete",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/domain-watch",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/reactivation-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/rep-payouts-due",
      "schedule": "0 9 1,15 * *"
    }
  ]
}
