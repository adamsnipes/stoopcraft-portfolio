# ============================================================================
# Supabase
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Cloudflare R2
# ============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=                            # Public bucket URL (server-side)
NEXT_PUBLIC_R2_PUBLIC_URL=                # Same value — exposed to browser for <img> src

# ============================================================================
# Stripe
# ============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=                  # price_xxx for Starter plan ($49/mo)
STRIPE_BIWEEKLY_PRICE_ID=                 # price_xxx for Biweekly plan ($34.50 / 2 weeks)
STRIPE_PRO_PRICE_ID=                      # price_xxx for Pro plan ($149/mo)
STRIPE_SETUP_PRICE_ID=                    # price_xxx for Website Setup (One-Time) — $300
STRIPE_MAINTENANCE_PRICE_ID=              # price_xxx for Site Maintenance & Support — $39/mo
STRIPE_SMS_PRICE_ID=  price_1TRBiQK61KMJqDDcT1xUXUn1                    # price_xxx for Lead-notification texts add-on — $79/mo

# ============================================================================
# Twilio (admin-side SMS dispatch — payment links, etc.)
# ============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                       # E.164 format, e.g. +15551234567

# ============================================================================
# Resend
# ============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=                        # e.g. notifications@stoopcraft.com
REPLY_TO_EMAIL=                           # e.g. developer@example.com — customer replies route here

# ============================================================================
# Anthropic
# ============================================================================
ANTHROPIC_API_KEY=

# ============================================================================
# Google Places (for content generation only, not scraping)
# Enable on the same GCP project: Places API (New) + Geocoding API.
# Geocoding powers the landing search's locationBias (Decision 48); if it's
# not enabled, search still works but service-area businesses won't be
# region-anchored.
# ============================================================================
GOOGLE_PLACES_API_KEY=

# ============================================================================
# Google Search Console (client search-performance reports) — OPTIONAL
#
# Service-account key file for the GCP project that reads Search Console. Raw
# JSON or base64-encoded (base64 survives newline mangling in env UIs). The
# service account must be added as a user on each client property. Unset =
# Admin → client → Search Report reports "not configured"; nothing else breaks.
# Full setup in MANUAL_SETUP.md §12.
# ============================================================================
GSC_SERVICE_ACCOUNT_JSON=

# ============================================================================
# Vercel (for programmatic domain management)
# ============================================================================
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ============================================================================
# Platform
# ============================================================================
PLATFORM_DOMAIN=stoopcraft.com
ADMIN_EMAIL=
ADMIN_SECRET=
CRON_SECRET=

# ============================================================================
# WHOIS (for domain renewal watchdog)
# ============================================================================
WHOIS_API_KEY=

# ============================================================================
# Namecheap (domain availability check for the landing-page claim wizard)
# ============================================================================
# Production path — call the namecheap-proxy service on Railway. Vercel
# functions have dynamic egress IPs so we can't whitelist them in Namecheap
# directly; the Railway proxy has a stable IP that we whitelist once.
# Credentials live on Railway, never on Vercel.
NAMECHEAP_PROXY_URL=                      # e.g. https://namecheap-proxy.up.railway.app
NAMECHEAP_PROXY_TOKEN=

# Local-dev fallback — call Namecheap directly from your machine. Requires
# whitelisting your home/office IP in Namecheap. Skip in production; the
# proxy above handles it. When neither path is configured the form shows
# "we'll confirm after payment" copy.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=                      # the egress IP you whitelisted
NAMECHEAP_SANDBOX=                        # set to 'true' to hit the sandbox API

# ---- Auto-register domain after Stripe checkout (domain_choice='need') ----
# Feature flag — leave 'false' to keep the existing manual queue. When 'true',
# the Stripe webhook calls the Namecheap proxy to register the customer's
# chosen .com, points NS at Vercel, and attaches the domain to the project.
# Failure path still alerts admin for manual takeover, so flipping this on is
# additive — nothing breaks if the proxy is down.
ENABLE_AUTO_DOMAIN_REGISTRATION=false

# Registrant contact reused for Registrant/Tech/Admin/AuxBilling on every
# auto-registered domain. WHOIS Privacy is enabled, but Namecheap still
# validates these fields against ICANN policy. Phone must be in their format:
# '+1.5551234567' (country code, dot, then digits — no spaces or dashes).
NAMECHEAP_REGISTRANT_FIRST_NAME=
NAMECHEAP_REGISTRANT_LAST_NAME=
NAMECHEAP_REGISTRANT_ADDRESS1=
NAMECHEAP_REGISTRANT_ADDRESS2=            # optional
NAMECHEAP_REGISTRANT_CITY=
NAMECHEAP_REGISTRANT_STATE_PROVINCE=
NAMECHEAP_REGISTRANT_POSTAL_CODE=
NAMECHEAP_REGISTRANT_COUNTRY=             # ISO-3166-1 alpha-2, e.g. US
NAMECHEAP_REGISTRANT_PHONE=               # e.g. +1.5551234567
NAMECHEAP_REGISTRANT_EMAIL=

# ============================================================================
# Tawk.to (live chat widget on landing + portal)
# ============================================================================
# Both IDs come from the embed snippet at Tawk.to → Administration →
# Channels → Chat Widget. Format: embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>.
# Leave blank to disable the widget entirely (renders nothing — no script
# tag, no CSP risk). The widget is suppressed on /sites/* and /admin/* in
# the component itself regardless of whether these are set.
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# ============================================================================
# Cloudflare Turnstile (landing-page abuse protection)
# ============================================================================
# Both keys come from the same widget in Cloudflare → Turnstile.
# Leave blank in dev/preview to disable Turnstile entirely; the landing
# generator and its API routes fall through to honeypot-only protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================================
# Axiom (logging)
# ============================================================================
AXIOM_TOKEN=
AXIOM_DATASET=

# ============================================================================
# Meta Conversions API (server-side Lead tracking)
# ============================================================================
# Server-to-server copy of the browser Pixel's Lead event, so blockers / Safari
# ITP can't silently drop conversions. Dedupes against the pixel via event_id.
# Token: Events Manager → your dataset → Settings → Conversions API →
# "Set up direct integration" → Generate access token. Long-lived, secret.
# Leave blank to disable CAPI (the browser pixel still fires on its own).
META_CAPI_ACCESS_TOKEN=
# Optional: while testing, paste the code from Events Manager → Test events to
# route Lead events there instead of live reporting. MUST be blank in prod.
META_CAPI_TEST_EVENT_CODE=

# ============================================================================
# PostHog (visitor analytics)
# ============================================================================
# Project API key from PostHog → Project Settings → Project API key.
# Leave blank to disable PostHog entirely — the provider no-ops without
# initializing, so no script loads and no events ship. Suppressed on
# customer-served sites (subdomains / custom domains) regardless of value.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com  # use https://eu.i.posthog.com for EU cloud

# Optional demo integrations. Leave blank to skip CRM forwarding.
SECUREMYLEAD_WEBHOOK_URL=
SECUREMYLEAD_WEBHOOK_URL_CHEAP=
PORTFOLIO_LEAD_INBOX=leads@example.com
