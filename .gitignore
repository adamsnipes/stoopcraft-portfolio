# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js
apps/web/.next/
apps/web/out/

# Vercel CLI local project link (project.json + README.txt) — machine-specific,
# regenerated by `vercel`, never belongs in git.
.vercel/

# Build
build/
dist/

# Env files — never commit secrets
.env
.env.local
.env.*.local

# Debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store
*.pem

# IDE
.vscode/settings.json
.idea/

# Test coverage
coverage/

# Supabase local
supabase/.branches/
supabase/.temp/

#claude
.claude/
.env.production
ubereats_cookies.txt
secure_leads/

# Client deliverable HTML pages live in the repo root for convenient upload to
# the admin dash — they must NOT be committed. Root-level only; app assets
# under apps/web/public/ are unaffected.
/*.html
/*.png
/*.jpg
/*.jpeg
/*.zip

blog-seo-guidelines.md
# Raw AI image exports dropped into deliverable folders — source artifacts, not
# part of the shipped site; never track (kept locally, just untracked).
ChatGPT Image*

*.jpg
# but keep client-site photos — websites/ is version-controlled
!websites/**/*.jpg
# and keep committed app assets under public/ (e.g. portfolio screenshots)
!apps/web/public/**/*.jpg

# Raw client source photos staged for a build (IMG_*/PXL_* originals, tens of MB
# each). The shipped site loads the processed .webp copies under images/, never
# these originals — keep local, never track.
websites/**/selected_images/

# Per-site source-artifact folders: raw logo/hero exports and unprocessed photos
# dropped in while building a site. Not referenced by the shipped HTML (which
# loads the processed copies) — source material, kept local, never tracked.
websites/**/_source/
websites/**/_src/
websites/thumbs-up-hlc/images/landscaping/
websites/thumbs-up-hlc/images/lawns/

# `_src-` prefixed exports and raw camera-original photos (IMG_*) dropped into a
# site's images/ folder while building it. The shipped site loads renamed .webp
# copies, never these — source material, kept local, never tracked.
websites/**/_src-*
websites/**/IMG_*.jpg
websites/**/IMG_*.jpeg
websites/**/IMG_*.png

# Anonymized demo bundles built from client sites for public showcase. Derived
# artifacts — regenerate per CLIENT_ANONYMIZATION.md; kept locally to redeploy
# the demo hosts the landing page links to.
websites/_demo-bundles/

# Video source artifacts. Self-hosted video is served from public R2
# (static-media/<slug>/), never from the repo or the client zip — so these are
# local staging copies plus raw exports. Tens of MB each; committing one bloats
# history permanently for a file the site never loads from git.
*.mp4
# .mov was missing here until two camera originals (88MB + 228MB) reached
# history in 752e081 / 55403b9 and GitHub's 100MB hard limit blocked the push.
*.mov
*.MOV

# Anonymization backups (see CLIENT_ANONYMIZATION.md). Created as
# `cp index.html index.original.bak.html` before swapping client PII out for a
# public demo, then moved back on revert. Local-only scratch — committing one
# risks the demo build landing in the repo as the client's deliverable while
# the real page survives only as the .bak (this happened in cfdec13).
*.original.bak.html
# Public portfolio credential and data exclusions
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.p12
*.key
*.db
*.sqlite
*.sqlite3
*.log
